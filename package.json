{
  "name": "voxmorph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "node scripts/ensure-electron.cjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:start": "node scripts/ensure-electron.cjs && electron .",
    "desktop:build": "node scripts/ensure-electron.cjs && npm run build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3",
    "cross-env": "^7.0.3"
  },
  "main": "app/electron.cjs",
  "build": {
    "appId": "ru.voxmorph.desktop",
    "productName": "VoxMorph",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "app/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "synopsis": "Audio reactive avatar for OBS",
      "description": "Procedural audio-reactive avatar desktop application."
    }
  }
}
